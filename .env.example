# Copy this file to .env and fill in your values before running docker compose

# Your VPS public IP (used as Nextcloud trusted domain)
SERVER_IP=your.server.ip.here

# Database passwords
DB_ROOT_PASSWORD=change_me_root
DB_PASSWORD=change_me_nextcloud

# Nextcloud admin credentials
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=change_me_admin

# Slack Incoming Webhook URL
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
